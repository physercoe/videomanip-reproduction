diff --git a/utils/trackio_logger.py b/utils/trackio_logger.py
new file mode 100644
index 0000000..0d38efc
--- /dev/null
+++ b/utils/trackio_logger.py
@@ -0,0 +1,40 @@
+"""Minimal pytorch-lightning Logger that forwards metrics to trackio
+(wandb replacement, per project decision 2026-07-22)."""
+import trackio
+from pytorch_lightning.loggers.logger import Logger
+from pytorch_lightning.utilities import rank_zero_only
+
+
+class TrackioLogger(Logger):
+    def __init__(self, project: str, name: str):
+        super().__init__()
+        self._name = name
+        self._run = trackio.init(project=project, name=name)
+
+    @property
+    def name(self):
+        return self._name
+
+    @property
+    def version(self):
+        return "0"
+
+    @rank_zero_only
+    def log_metrics(self, metrics, step=None):
+        # convert tensors to floats
+        clean = {}
+        for k, v in dict(metrics).items():
+            try:
+                clean[k] = float(v)
+            except (TypeError, ValueError):
+                pass
+        if clean:
+            trackio.log(clean, step=step)
+
+    @rank_zero_only
+    def log_hyperparams(self, params):
+        pass
+
+    @rank_zero_only
+    def finalize(self, status):
+        trackio.finish()
